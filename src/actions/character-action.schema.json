{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.riai.example/schemas/character-action-envelope-v1.json",
  "title": "Riai and Noa high-level Character Action envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "requestId", "actions"],
  "properties": {
    "version": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "character", "expression"],
            "properties": {
              "action": { "const": "setExpression" },
              "character": { "enum": ["riai", "noa"] },
              "expression": {
                "enum": [
                  "neutral",
                  "happy",
                  "surprised",
                  "thinking",
                  "concerned",
                  "curious"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "character", "x", "y"],
            "properties": {
              "action": { "const": "lookAt" },
              "character": { "enum": ["riai", "noa"] },
              "x": { "type": "number", "minimum": -1, "maximum": 1 },
              "y": { "type": "number", "minimum": -1, "maximum": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "character", "target"],
            "properties": {
              "action": { "const": "lookAtCharacter" },
              "character": { "enum": ["riai", "noa"] },
              "target": { "enum": ["riai", "noa"] }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "character", "motion"],
            "properties": {
              "action": { "const": "playMotion" },
              "character": { "enum": ["riai", "noa"] },
              "motion": {
                "enum": [
                  "idle",
                  "greet",
                  "listen",
                  "reactLight",
                  "earTwitch",
                  "tailSway"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": { "const": "emergencyStop" }
            }
          }
        ]
      }
    }
  }
}
