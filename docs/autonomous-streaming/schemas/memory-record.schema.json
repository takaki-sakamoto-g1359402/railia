{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riai.local/schemas/memory-record.json",
  "title": "Riai Memory Record",
  "type": "object",
  "required": ["memory_id", "memory_type", "created_at", "content", "provenance", "write_policy"],
  "properties": {
    "memory_id": {"type": "string"},
    "memory_type": {"enum": ["working", "episodic", "semantic", "skill", "persona"]},
    "created_at": {"type": "string", "format": "date-time"},
    "content": {},
    "importance": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "provenance": {
      "type": "object",
      "required": ["source", "trust_level"],
      "properties": {
        "source": {"type": "string"},
        "trust_level": {"enum": ["trusted", "mixed", "untrusted"]}
      },
      "additionalProperties": true
    },
    "write_policy": {"enum": ["ephemeral", "automatic", "review_required", "immutable"]},
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
