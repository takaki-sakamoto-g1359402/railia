{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riai.local/schemas/action.json",
  "title": "Riai Executable Action",
  "type": "object",
  "required": ["action_id", "type", "target", "args", "risk", "approval", "timeout_ms", "max_retries", "verify"],
  "properties": {
    "action_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": ["string", "null"], "maxLength": 128},
    "type": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "args": {"type": "object"},
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "approval": {"enum": ["automatic", "constrained", "human_required", "deny"]},
    "timeout_ms": {"type": "integer", "minimum": 100, "maximum": 600000},
    "max_retries": {"type": "integer", "minimum": 0, "maximum": 5},
    "verify": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "expected": {}
      },
      "additionalProperties": true
    },
    "rollback": {"type": ["object", "null"], "additionalProperties": true}
  },
  "additionalProperties": false
}
